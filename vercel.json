{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/proxy/:path*", "destination": "/api/proxy/:path*" },
    { "source": "/s=:query", "destination": "/api/page" },
    { "source": "/player.html", "destination": "/api/player" },
    { "source": "/player.html/:path*", "destination": "/api/player" },
    { "source": "/index.html", "destination": "/api/page" },
    { "source": "/", "destination": "/api/page" },
    { "source": "/:path*", "destination": "/api/page" }
  ]
}
