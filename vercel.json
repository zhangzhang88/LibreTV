{
  "version": 2,
  "builds": [
    { "src": "api/**/*.mjs", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/proxy/(.*)", "dest": "/api/proxy/$1" },
    { "src": "/s=(.*)", "dest": "/index.html" },
    { "src": "/player.html(?:/.*)?", "dest": "/player.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
